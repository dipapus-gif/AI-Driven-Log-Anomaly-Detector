{
  "name": "log-anomaly-detector-desktop",
  "version": "1.1.0",
  "description": "Desktop app for the Log Anomaly Detector platform",
  "main": "main.js",
  "author": {
    "name": "dipapus-gif",
    "email": "dipapus-gif@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.log-anomaly-detector",
    "productName": "Log Anomaly Detector",
    "copyright": "Copyright \u00a9 dipapus-gif",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "build/icon.png"
    ],
    "artifactName": "Log-Anomaly-Detector-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Security",
      "icon": "build/icon.png",
      "maintainer": "dipapus-gif <dipapus-gif@users.noreply.github.com>",
      "synopsis": "Log Anomaly Detector desktop app"
    },
    "publish": null
  },
  "homepage": "https://github.com/dipapus-gif/AI-Driven-Log-Anomaly-Detector"
}
